# Turso Database (get these from https://turso.tech)
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# App password - generate with: node -e "require('bcryptjs').hash('yourpassword', 10).then(console.log)"
APP_PASSWORD_HASH=$2a$10$...

# Session secret (any random string)
SESSION_SECRET=change-me-to-something-random
